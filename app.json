{
  "expo": {
    "name": "CS 321 Lecture Recorder",
    "slug": "cs321-lecture-recorder",
    "owner": "cs-321-project",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cs321lecturerecorder",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "dev.tcfusion.cs321lecturerecorder"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#005239",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.tcfusion.cs321lecturerecorder"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#005239",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to record audio.",
          "enableBackgroundRecording": true,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-sqlite",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7ebc3f8d-6376-47d3-90ec-bc8257dfc3f6"
      }
    }
  }
}
